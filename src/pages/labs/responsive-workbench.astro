---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Responsive workbench — Justin Tahai" description="A bounded responsive component demonstration."><header class="page-intro"><span class="eyebrow">Component laboratory</span><h1>Test the<br />constraint.</h1><p>This uses the portfolio’s own component treatment. Change the bounded viewport and content state to see what a layout needs to handle.</p></header><section class="lab-shell"><div class="tool"><div class="tool-controls"><button data-width="narrow" aria-pressed="true">390px</button><button data-width="medium" aria-pressed="false">768px</button><button data-width="wide" aria-pressed="false">Wide</button><button data-stress aria-pressed="false">Long content</button></div><div class="workbench-frame narrow" data-frame><div class="workbench-nav"><strong>Project context</strong><span>Menu</span></div><div class="workbench-card"><span class="eyebrow">A responsive card</span><h3 data-demo-title>Make the route clear before making it clever.</h3><p data-demo-copy>Flexible width, a direct hierarchy, and a visible action are the starting point.</p><a href="/notes/responsive-constraints/">Read the constraint note →</a></div></div></div></section><script>// @ts-nocheck
const frame=document.querySelector('[data-frame]'),title=document.querySelector('[data-demo-title]'),copy=document.querySelector('[data-demo-copy]');document.querySelectorAll('[data-width]').forEach(button=>button.addEventListener('click',()=>{frame.className=`workbench-frame ${button.dataset.width}`;document.querySelectorAll('[data-width]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)))}));document.querySelector('[data-stress]').addEventListener('click',e=>{const on=e.currentTarget.getAttribute('aria-pressed')!=='true';e.currentTarget.setAttribute('aria-pressed',String(on));title.textContent=on?'Long labels should reveal the layout, not break it when a real name, destination, or task needs more room.':'Make the route clear before making it clever.';copy.textContent=on?'The component keeps its reading order, action, and boundaries under intentionally awkward content.':'Flexible width, a direct hierarchy, and a visible action are the starting point.'})</script></BaseLayout>
