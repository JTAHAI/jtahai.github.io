---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Request-path lab — Justin Tahai" description="A local explanatory simulation of common web request paths."><header class="page-intro"><span class="eyebrow">Local simulation · fixed rules</span><h1>Follow a<br />request path.</h1><p>Choose a scenario. The steps below are explanatory examples, not live diagnostics or infrastructure control.</p></header><section class="lab-shell"><div class="tool"><div class="tool-controls"><button data-scenario="static" aria-pressed="true">Cached static page</button><button data-scenario="api" aria-pressed="false">Protected API</button><button data-scenario="tls" aria-pressed="false">Origin certificate fault</button><button data-scenario="fallback" aria-pressed="false">Missing resource</button></div><p data-path-summary>A browser requests a published page; the CDN can serve its current cached artifact.</p><div class="path-steps" data-path-steps></div><p class="export-note">The model uses fixed, documented outcomes: it does not inspect the visitor’s network or any live service.</p></div></section><script>
// @ts-nocheck
const paths = { static:{summary:'A browser requests a published page; the CDN can serve its current cached artifact.', steps:['Browser request','DNS / edge route','CDN cache hit','Static artifact','HTML response']}, api:{summary:'A browser requests a protected endpoint. The request reaches an application boundary, which may require a valid session.', steps:['Browser request','DNS / edge route','Application route','Auth boundary','401 or permitted response']}, tls:{summary:'The edge reaches an origin but the origin certificate does not complete a trusted handshake. The useful next action is origin inspection, not an HTML redirect.', steps:['Browser request','DNS / edge route','Edge to origin','TLS handshake fails','Origin error']}, fallback:{summary:'A referenced resource is unavailable. The page remains useful when its content and fallback are designed independently.', steps:['Browser request','DNS / edge route','Static artifact','Resource unavailable','Visible fallback']} };
const stepEl=document.querySelector('[data-path-steps]'),summary=document.querySelector('[data-path-summary]'); function draw(key){const path=paths[key];summary.textContent=path.summary;stepEl.innerHTML=path.steps.map((step,i)=>`<div class="path-step ${i===path.steps.length-1?'active':''}"><span>${String(i+1).padStart(2,'0')}</span><br>${step}</div>`).join('')} draw('static'); document.querySelectorAll('[data-scenario]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-scenario]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));draw(button.dataset.scenario)}));
</script></BaseLayout>
