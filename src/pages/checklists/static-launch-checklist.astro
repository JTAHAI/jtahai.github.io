---
import BaseLayout from '../../layouts/BaseLayout.astro';
const checks = ['One clear H1 and a meaningful page purpose', 'Keyboard navigation, focus visibility, and Escape behavior', 'Readable layout at 320px and 200% zoom', 'Current canonical, social, and sitemap URLs', 'No missing assets, fragments, or stale public links', 'A documented source, deployment target, and rollback reference', 'Motion can stop and a static fallback remains useful', 'Forms, auth, and checkout tested only in authorized environments'];
---
<BaseLayout title="Static launch checklist — Justin Tahai" description="A local, exportable static-site launch readiness checklist."><header class="page-intro"><span class="eyebrow">Practical tool · local only</span><h1>Launch with<br />a usable record.</h1><p>Check items as you assess them. Progress is stored in this browser when storage is available; it is your assessment, not a certification.</p></header><section class="lab-shell"><div class="tool"><div class="progress" aria-label="Checklist completion"><span data-progress></span></div><p data-count>0 of {checks.length} checked</p><div class="checklist" data-checklist>{checks.map((check, i) => <label><input type="checkbox" data-check={i} /> <span>{check}</span></label>)}</div><div class="tool-controls"><button data-export="markdown">Export Markdown</button><button data-export="json">Export JSON</button><button data-reset>Reset</button><button data-print>Print</button></div><p class="export-note">Export is generated locally. No data is sent to a server.</p></div></section><script is:inline define:vars={{ checks }}>// @ts-nocheck
const key='jt-launch-checklist-v1',items=[...document.querySelectorAll('[data-check]')],progress=document.querySelector('[data-progress]'),count=document.querySelector('[data-count]');let state=[];try{state=JSON.parse(localStorage.getItem(key)||'[]')}catch{};function update(){items.forEach((item,i)=>item.checked=!!state[i]);const done=state.filter(Boolean).length;progress.style.width=`${done/items.length*100}%`;count.textContent=`${done} of ${items.length} checked`;try{localStorage.setItem(key,JSON.stringify(state))}catch{}}items.forEach((item,i)=>item.addEventListener('change',()=>{state[i]=item.checked;update()}));document.querySelector('[data-reset]').addEventListener('click',()=>{state=[];update()});document.querySelector('[data-print]').addEventListener('click',()=>window.print());function download(type){const data=checks.map((check,i)=>({check,complete:!!state[i]}));const content=type==='json'?JSON.stringify({generatedAt:new Date().toISOString(),checks:data},null,2):'# Static launch checklist\n\n'+data.map(x=>`- [${x.complete?'x':' '}] ${x.check}`).join('\n');const blob=new Blob([content],{type:type==='json'?'application/json':'text/markdown'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`static-launch-checklist.${type==='json'?'json':'md'}`;a.click();URL.revokeObjectURL(a.href)}document.querySelectorAll('[data-export]').forEach(button=>button.addEventListener('click',()=>download(button.dataset.export)));update();</script></BaseLayout>
