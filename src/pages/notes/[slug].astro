---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { notes } from '../../data/content';
export function getStaticPaths() { return notes.map(note => ({params:{slug:note.slug}, props:{note}})); }
const { note } = Astro.props;
const bodies: Record<string, string[]> = {
  'static-first': ['Static output is not a claim that a site has no risk. It is a way to make the public path smaller and easier to inspect. A page can still have a domain, build dependencies, client scripts, and an account boundary that deserve care.', 'The useful question is whether a runtime dependency earns its place. Content, documentation, and public routes often become more durable when they can render before a server decides what to do. Dynamic parts can remain narrow and explicit.'],
  'responsive-constraints': ['Responsive work fails when a design only exists at its happiest width. A long label, a short laptop window, a translated string, or 200% zoom tells you whether the layout has a real constraint or only a series of emergency overrides.', 'Start with flexible containers, readable line lengths, and a navigation model that can become small without becoming hidden. Test the actual content, including its longest names, before declaring a breakpoint complete.'],
  'motion-with-consent': ['Motion can establish hierarchy or convey a change of state. It should never be the only way a visitor can understand a page. The static state needs to be intentional enough that reduced motion is not a lesser experience.', 'For media, this means a visible poster, honest play state, and a fallback when autoplay or decoding does not happen. A pause button is only useful when it controls the thing it names.'],
  'delivery-parity': ['A domain can point at one runtime while a local folder describes another. A deployment can be healthy while its source is incomplete. These are not cosmetic discrepancies: they make a future repair unsafe.', 'Keep a small ledger for each public site: canonical hostname, source repository and revision, output directory, deployment target, current release, rollback reference, and owner. It turns a vague website task into a checkable change.'],
  'product-status-data': ['Release dates, beta labels, access promises, and operator attribution should be maintained as authoritative facts. When each site invents its own version, public copy drifts faster than any rewrite pass can repair it.', 'A content contract gives each product a place to define status, business context, and review date. Sites can render it in their own voice while still sharing the same underlying fact.'],
  'portfolio-as-proof': ['A portfolio earns trust when it exposes the reasoning behind a result. It does not need surveillance-like dashboards or fabricated metrics to look technical. A clear constraint, a deliberate decision, and a public artifact are enough to begin a useful conversation.', 'The interactive tools here run locally and describe fixed examples. They are deliberately labeled as demonstrations, because a visual metaphor should never be mistaken for production control.']
};
---
<BaseLayout title={`${note.title} — Justin Tahai`} description={note.deck}><header class="page-intro"><time class="eyebrow" datetime={note.date}>{note.date} · Systems note</time><h1>{note.title}</h1><p>{note.deck}</p></header><article class="prose">{bodies[note.slug].map((paragraph, index) => <Fragment>{index === 1 && <h2>The practical test</h2>}<p>{paragraph}</p></Fragment>)}<h2>Related practice</h2><p>Use this note as a prompt for a concrete review: identify the current public route, the source that owns it, the people it needs to serve, and the failure state it must survive.</p><p><a href="/notes/">← Back to notes</a></p></article></BaseLayout>
